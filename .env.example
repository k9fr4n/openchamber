# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# Mot de passe d'accès à l'interface web (obligatoire).
# Générer par exemple avec : openssl rand -base64 24
OPENCHAMBER_UI_PASSWORD=

# --- Authentification des CLI dans le conteneur ---

# gh (github.com) : token personnel portée `repo` (+ `workflow` si l'agent doit
# modifier des fichiers .github/workflows). Générer sur :
# https://github.com/settings/tokens
GH_TOKEN=

# glab (gitlab.ecritel.net) : token personnel portée `api`
# (+ `write_repository` pour un git push via HTTPS). Générer sur :
# https://gitlab.ecritel.net/-/user_settings/personal_access_tokens
GITLAB_TOKEN=

# Instance GitLab ciblée par glab (défauts : gitlab.ecritel.net).
#GITLAB_HOST=gitlab.ecritel.net
#GITLAB_API_HOST=gitlab.ecritel.net

# Dossier du Pi exposé comme espace de travail de l'agent.
# Défaut : ./workspaces (dans le dossier du repo).
# Exemple pour travailler sur tous tes repos perso :
#WORKSPACES_DIR=/home/pi/gitlab

# Image à utiliser. Défaut : dernière version construite par GitHub Actions.
# Épingler une version précise (tags publiés : v2.5.3, sha-xxxxx, latest) :
#OPENCHAMBER_IMAGE=ghcr.io/k9fr4n/openchamber:v2.5.3

# Port d'écoute sur le Pi (défaut : 3000).
#OPENCHAMBER_PORT=3000

# GID du groupe `docker` sur le Pi, pour l'accès au socket Docker monté dans
# le conteneur. Vérifier avec : getent group docker | cut -d: -f3
DOCKER_GID=985

# --- Navigation Web autonome (Playwright MCP) ---
# Voir docs/playwright-mcp.md.

# Image du serveur Playwright MCP (multi-arch, inclut arm64).
# Épingler une version précise après vérification :
#PLAYWRIGHT_MCP_IMAGE=mcr.microsoft.com/playwright/mcp:v0.0.83

# Port d'écoute du serveur MCP, joignable UNIQUEMENT depuis le réseau Docker
# privé `browser` (aucun port publié, aucune route Traefik). Changer cette
# valeur impose de mettre à jour l'URL MCP côté OpenCode (voir
# scripts/setup-playwright-mcp.sh).
#PLAYWRIGHT_MCP_PORT=8931
