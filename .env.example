# Copier ce fichier en .env puis renseigner les valeurs.
# Le fichier .env n'est jamais commité (voir .gitignore).

# Mot de passe d'accès à l'interface web (obligatoire).
# Générer par exemple avec : openssl rand -base64 24
OPENCHAMBER_UI_PASSWORD=

# Dossier du Pi exposé comme espace de travail de l'agent.
# Défaut : ./workspaces (dans le dossier du repo).
# Exemple pour travailler sur tous tes repos perso :
#WORKSPACES_DIR=/home/pi/gitlab

# Image à utiliser. Défaut : dernière version construite par GitHub Actions.
# Épingler une version précise (tags publiés : v2.0.2, sha-xxxxx, latest) :
#OPENCHAMBER_IMAGE=ghcr.io/k9fr4n/openchamber:v2.0.2

# Port d'écoute sur le Pi (défaut : 3000).
#OPENCHAMBER_PORT=3000