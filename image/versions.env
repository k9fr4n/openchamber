# Source unique des versions des outils ajoutés à l'image.
#
# Mettre à jour une version ici, puis relancer le workflow "Build image arm64"
# (ce fichier fait partie des chemins qui déclenchent un rebuild).
#
# Si le build échoue avec « version introuvable » pour un paquet Debian, c'est
# qu'une mise à jour est sortie dans trixie : relever la nouvelle version avec
#   docker run --rm <image de base> sh -c 'apt-get update -qq && apt-cache policy <paquet>'
# puis actualiser la valeur ci-dessous.

# --- Paquets Debian (trixie) ---
GH_VERSION=2.46.0-3
GLAB_VERSION=1.53.0-1+b3
CURL_VERSION=8.14.1-2+deb13u5
JQ_VERSION=1.7.1-6+deb13u3
IPROUTE2_VERSION=6.15.0-1
PROCPS_VERSION=2:4.0.4-9
LSOF_VERSION=4.99.4+dfsg-2

# --- Binaires officiels amont ---
# https://download.docker.com/linux/static/stable/aarch64/
DOCKER_CLI_VERSION=29.8.1
# https://github.com/mikefarah/yq/releases
YQ_VERSION=v4.53.6
