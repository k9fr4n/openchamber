# Source unique des versions des outils ajoutés à l'image.
#
# Mettre à jour une version ici, puis relancer le workflow "Build image arm64"
# (ce fichier fait partie des chemins qui déclenchent un rebuild).
#
# Paquets Debian : les versions servent d'épingles, mais si une mise à jour
# Debian les rend indisponibles, le build installe les versions courantes de
# trixie avec un avertissement dans les logs — il n'échoue pas. Relever alors
# les nouvelles versions avec
#   docker run --rm <image> sh -c 'apt-get update -qq && apt-cache policy <paquet>'
# et actualiser les valeurs ci-dessous.
#
# Binaires amont (docker, yq) : versions strictement épinglées, mises à jour
# manuellement ici.

# --- Paquets Debian (trixie) ---
GH_VERSION=2.46.0-3
GLAB_VERSION=1.53.0-1+b3
CURL_VERSION=8.14.1-2+deb13u5
JQ_VERSION=1.7.1-6+deb13u3
IPROUTE2_VERSION=6.15.0-1
PROCPS_VERSION=2:4.0.4-9
LSOF_VERSION=4.99.4+dfsg-2

# --- Binaires officiels amont ---
# https://download.docker.com/linux/static/stable/aarch64/
DOCKER_CLI_VERSION=29.8.1
# Empreinte SHA256 de l'archive téléchargée (par architecture).
# Mettre à jour avec la version — calcul : curl -sL <url> | sha256sum
# Laisser vide pour ignorer la vérification.
DOCKER_CLI_SHA256_ARM64=667395fbffab52901b80181dfbb39ea76da2fbd7642c4fbddd24e42146b07b48
DOCKER_CLI_SHA256_AMD64=
# https://github.com/mikefarah/yq/releases
# (empreinte vérifiée automatiquement via le fichier checksums-bsd de la release)
YQ_VERSION=v4.53.6
