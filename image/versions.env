# Versions des binaires amont épinglés dans l'image.
#
# Seuls les outils téléchargés directement (docker, yq, codebase-memory-mcp)
# sont épinglés ici :
# leurs archives sont vérifiées par empreinte, donc la version installée est
# toujours exactement celle écrite ci-dessous. Les paquets Debian, eux, sont
# installés dans leur version courante de trixie par APT — les épingler
# imposait une maintenance constante sans reproductibilité réelle, puisque le
# build retombait de toute façon sur la version courante dès qu'une épingle
# périmait.
#
# Mettre à jour une version ici, puis relancer le workflow "Build image arm64"
# (ce fichier fait partie des chemins qui déclenchent un rebuild).

# --- docker CLI (binaire statique officiel) ---
# https://download.docker.com/linux/static/stable/aarch64/
DOCKER_CLI_VERSION=29.9.2
# Empreinte SHA256 de l'archive téléchargée (par architecture).
# Mettre à jour avec la version — calcul : curl -sL <url> | sha256sum
# Laisser vide pour ignorer la vérification.
DOCKER_CLI_SHA256_ARM64=873b3e0207857c3b2f28392fb922f3ea6efe37620c16d4d4aaf2fef409c90b73
DOCKER_CLI_SHA256_AMD64=

# --- yq (binaire officiel mikefarah) ---
# https://github.com/mikefarah/yq/releases
# (empreinte vérifiée automatiquement via le fichier checksums-bsd de la release)
YQ_VERSION=v4.54.1

# --- codebase-memory-mcp (binaire officiel DeusData, build portable statique) ---
# https://github.com/DeusData/codebase-memory-mcp/releases
# Archives "-portable" : builds entièrement statiques (même logique que
# install.sh upstream, qui préfère le portable sous Linux pour les glibc
# anciennes). Empreintes issues du fichier checksums.txt de la release.
CBM_VERSION=v0.12.1
CBM_SHA256_ARM64=ed0f1f548cd79b121c401c2e9f7841c189a001af26d3768368088c24f6a53533
CBM_SHA256_AMD64=8c3d0341064301e78ecc84cf7348d4e2c6562a0f57448243ea560aaa34de36c1
